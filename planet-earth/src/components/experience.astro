---
import { content } from './languages';
const { t = {} } = Astro.props; 
---
<section id="experience">
  <h2 data-key="experience">{t.experience}</h2>
  
  <div class="timeline">
    <div class="timeline-item">
      <div class="time-dot"></div>
      <h3 data-key="job1Title">{t.job1Title}</h3>
      <p class="meta" data-key="job1Place">{t.job1Place}</p>
      <div class="quest-details">
        <p data-key="job1Desc">{t.job1Desc}</p>
      </div>
      <div class="loot-tags">
        <span class="tag">Python</span>
        <span class="tag">Debian Linux</span>
        <span class="tag">Raspberry Pi</span>
        <span class="tag">Kanban</span>
      </div>
    </div>

    <div class="timeline-item">
      <div class="time-dot"></div>
      <h3 data-key="job2Title">{t.job2Title}</h3>
      <p class="meta" data-key="job2Place">{t.job2Place}</p>
      <div class="quest-details">
        <p data-key="job2Desc">{t.job2Desc}</p>
      </div>
      <div class="loot-tags">
        <span class="tag" data-key="tagDoc">{t.tagDoc}</span>
        <span class="tag">Troubleshooting</span>
        <span class="tag" data-key="tagEnd">{t.tagEnd}</span>
      </div>
    </div>

    <div id="extra-experience" class="hidden-experience">
      <div class="timeline-item">
        <div class="time-dot"></div>
        <h3 data-key="taTitle">{t.taTitle}</h3>
        <p class="meta" data-key="taPlace">{t.taPlace}</p>
        <div class="quest-details">
          <p data-key="taDesc">{t.taDesc}</p>
        </div>
        <div class="loot-tags">
          <span class="tag">C</span>
          <span class="tag">Assembly</span>
          <span class="tag" data-key="tagDebug">{t.tagDebug}</span>
        </div>
      </div>
    </div>

    <button id="exp-toggle-btn" class="archive-toggle">
      <span class="toggle-text" data-key="viewM">{t.viewM}</span>
      <i class="fa-solid fa-chevron-down"></i>
    </button>
  </div>
</section>

<script define:vars={{ content }}>
  const btn = document.getElementById('exp-toggle-btn');
  const container = document.getElementById('extra-experience');
  const textSpan = btn?.querySelector('.toggle-text');
  const icon = btn?.querySelector('i');

  // 1. Expansion Click Logic
  btn?.addEventListener('click', () => {
    if (!container || !textSpan || !icon) return;

    const isOpen = container.classList.toggle('active');
    icon.style.transform = isOpen ? 'rotate(180deg)' : 'rotate(0deg)';
    
    // Read the current selected language from storage or HTML tag
    const lang = localStorage.getItem('lang') || document.documentElement.lang || 'EN';
    
    // Force the correct key and word string instantly on click
    textSpan.setAttribute('data-key', isOpen ? 'viewL' : 'viewM');
    textSpan.innerText = isOpen ? content[lang].viewL : content[lang].viewM;
  });

  // 2. Local Language Sync Logic
  // Listens to your global switcher event and forces this specific button to update
  window.addEventListener('langChange', (e) => {
    if (!container || !textSpan) return;
    
    const lang = e.detail; // 'EN' or 'PT'
    const t = content[lang];
    const isCurrentlyOpen = container.classList.contains('active');

    textSpan.setAttribute('data-key', isCurrentlyOpen ? 'viewL' : 'viewM');
    textSpan.innerText = isCurrentlyOpen ? t.viewL : t.viewM;
  });
</script>